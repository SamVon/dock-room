# Copy this file to .env and adjust. Never commit .env or put real secrets in this file.

NODE_ENV=development

# Port the server listens on (pages and Socket.IO share it). Most hosts set this for you.
PORT=3000

# REQUIRED in production. The one website address allowed to use this server,
# for example https://duckroom.example.com. Other origins are refused.
APP_ORIGIN=http://localhost:3000

# REQUIRED in production. Signs the anonymous session cookie. Use 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. In development a temporary one is generated when empty.
SESSION_SECRET=

# Set to true only when the server is behind a proxy you control (Cloudflare, nginx),
# so rate limits use the visitor's real address from the proxy headers.
TRUST_PROXY=false

# The scene new rooms start in: valley, or festival for the Boat Festival season.
DEFAULT_SCENE=valley

# --- Seasonal events ---
# Events start and end by their dates (config/events.ts, or edited on /admin/events).
# To switch one on regardless of its dates, for testing or to show friends, name it here:
# boat-festival, halloween, full-moon, loy-krathong, christmas, new-year, valentine, sakura-festival, pi-mai, rainy-season
FORCE_EVENT=

# Admin accounts are not kept here. They are in the database file DATA_DIR/duck-room.db, as
# password hashes. Make one on the server with:  npm run admin set <name>

# Folder where events changed on the admin page are saved.
DATA_DIR=data

MAX_ROOM_USERS=50
# Ducks in one room's voice chat. Each talker sends their sound straight to every other one,
# so keep this small (8 is comfortable; much more and phones struggle).
MAX_VOICE_USERS=8
MAX_ROOMS=1000
MAX_MESSAGE_LENGTH=300
EMPTY_ROOM_TTL_SECONDS=300
OWNER_GRACE_SECONDS=30
# How long a duck stays in the room after its connection drops (reload, short network loss).
PRESENCE_GRACE_SECONDS=30

# Optional trusted https stream or file per station. Empty = the browser generates the music.
LOFI_STREAM_URL=
JAZZ_STREAM_URL=
RAIN_STREAM_URL=
PIANO_STREAM_URL=

# --- Voice chat ---
# Sound goes directly between browsers. These servers only help two browsers find each other.
# STUN is enough for most home networks. Comma-separated; empty = a public Google STUN server.
STUN_URLS=
# On mobile data and office networks there is often no direct path. Only a TURN server, which
# relays the sound, works there (for example coturn, or a hosted TURN service). Without one,
# some people will join the voice chat and hear nothing.
# The user name and password are sent to every browser that joins the voice chat, as TURN requires.
# Use an account made only for this, never a password that protects anything else.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
